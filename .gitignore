# Local tooling
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------
# LexGap (subproject) runtime state
#
# The SQLite database, downloaded corpora and run logs are per-machine
# experiment state, not source.  The schema is recreated by `lexgap init-db`
# and the sampling spec is versioned in specs/.
# ---------------------------------------------------------------
lexgap/data/
lexgap/logs/
lexgap/*.db
lexgap/*.db-wal
lexgap/*.db-shm

# ---------------------------------------------------------------
# Vendored upstream checkout and dictionary data.
#
# tkrzw-dict/ is a clone of https://github.com/estraier/tkrzw-dict.git
# plus the union dictionary data, which is a separate ~900 MB download
# from https://dbmx.net/dict/union-dict-data.tar.gz.  Neither belongs in
# this repository; run scripts/setup.sh to reproduce both.
# ---------------------------------------------------------------
tkrzw-dict/

# Dictionary data, in case it is ever placed at the repository root.
union-body.tkh
union-tran-index.tkh
union-infl-index.tkh
union-keys.txt
union-tran-keys.txt
union-examples.tsv
union-dict-data.tar.gz
*.tkh
*.tks
